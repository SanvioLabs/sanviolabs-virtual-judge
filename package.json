{
  "name": "virtual-judge",
  "version": "0.1.0",
  "description": "AI-powered hackathon judging tool",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn server:app --reload --port 8000",
    "start": "uv run uvicorn server:app --host 0.0.0.0 --port 8000",
    "setup": "uv sync && cp -n .env.example .env || true",
    "lint": "uv run ruff check .",
    "lint:fix": "uv run ruff check --fix .",
    "test": "uv run pytest tests/ -v",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:install": "npx playwright install chromium",
    "test:all": "npm run test && npm run test:e2e",
    "db:reset": "rm -f judge.db judge.db-wal judge.db-shm && echo 'Database reset.'",
    "audio:clean": "rm -rf audio_recordings/*.webm audio_recordings/*.mp3 && echo 'Audio files cleaned.'",
    "exports:clean": "rm -rf exports/* && echo 'Export bundles removed.'",
    "purge": "uv run python scripts/purge.py",
    "reset": "npm run db:reset && npm run audio:clean && npm run exports:clean"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0"
  }
}
