# Required API keys
OPENROUTER_API_KEY=sk-or-v1-...   # Transcription + scoring (both run through OpenRouter)
ELEVENLABS_API_KEY=sk_...         # For TTS voice output
ELEVENLABS_VOICE_ID=...           # Your custom voice ID (defaults to Rachel if not set)

# Optional model overrides (defaults shown)
# OPENROUTER_SCORING_MODEL=anthropic/claude-sonnet-5
# OPENROUTER_TRANSCRIPTION_MODEL=google/gemini-3.7-flash
# OPENROUTER_PRFAQ_MODEL=            # Falls back to the scoring model. PRFAQ writing is
#                                    # heavier than scoring — worth a stronger model.

# Optional behaviour overrides (defaults shown)
# VJ_MAX_UPLOAD_MB=100                # Ceiling on a single recording upload
# VJ_FINALIST_TRANSCRIPT_CHARS=6000   # How much of each pitch the finalist round reads
# VJ_DB_PATH=./judge.db               # Where the database lives. The test suite sets this
# VJ_ACCESS_CODE=                    # Require this code when the event is on a shared network
